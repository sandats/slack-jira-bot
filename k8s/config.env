JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_API_BASE=https://api.atlassian.com/ex/jira/<cloudId>
JIRA_EMAIL=service-account@example.com
JIRA_PROJECT_KEY=<projectKey>
JIRA_ISSUE_TYPE_ID=<issueTypeId>
JIRA_SET_REPORTER=0
# 必須: 操作を許可する Slack ユーザー ID（カンマ区切り）。全員許可する場合は * 。未設定だと起動しません
ALLOWED_USER_IDS=
JIRA_CLOSE_TRANSITION_ID=
JIRA_CLOSE_RESOLUTION=
JIRA_CANCEL_TRANSITION_ID=
JIRA_CANCEL_RESOLUTION=
HTTP_ADDR=:8080
